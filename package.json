{
  "name": "motogo-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Web y panel de administración de Motogo (La Vega • Bonao • SFM • Moca)",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 8080 --strictPort",
    "share": "vite build --mode tunnel && vite preview --mode tunnel --port 8080 --strictPort",
    "db:start": "supabase start -x realtime,imgproxy,mailpit,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "admin:create": "node scripts/create-admin.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0"
  },
  "devDependencies": {
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "autoprefixer": "^10.6.2",
    "lightningcss": "^1.33.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "vite": "^6.4.6"
  }
}
